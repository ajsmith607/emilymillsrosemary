<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} | {% endif %}Emily Mills Rosemary</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  {% include "header.njk" %}
  <main>
    {% if title %}<h1>{{ title }}</h1>{% endif %}
    {% if description %}<h2>{{ description }}</h2>{% endif %}
    {{ content | safe }}
  </main>
  {% include "footer.njk" %}
</body>
</html>
